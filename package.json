{
  "name": "noc-network-incident-copilot",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0 --port 5173 --base /",
    "dev:monitor": "node server/index.mjs",
    "dev:full": "node scripts/dev-full.mjs",
    "build": "tsc -b && vite build",
    "test:monitor": "node scripts/test-monitor.mjs",
    "preview": "vite preview",
    "dev:backend": "node --env-file-if-exists=.env server/index.mjs",
    "test:backend": "node --env-file-if-exists=.env scripts/test-backend.mjs",
    "db:migrate": "node --env-file-if-exists=.env server/db/migrate.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "recharts": "^2.15.0",
    "vite": "^6.0.5",
    "zustand": "^5.0.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.7.2"
  }
}
