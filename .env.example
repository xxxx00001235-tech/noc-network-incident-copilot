# demo：使用既有展示資料；live：讀取本機監控 API
VITE_DATA_MODE=demo
VITE_API_BASE_URL=http://127.0.0.1:3001

# Ubuntu VM 上的 FastAPI。開發與 Production 都使用 /fastapi 同源路徑；部署端需設定反向代理。
VITE_FASTAPI_BASE_URL=/fastapi
FASTAPI_PROXY_TARGET=http://192.168.176.130:8000

# 本機監控 API 固定只監聽 127.0.0.1。
MONITOR_PORT=3001
MONITOR_SAMPLE_INTERVAL_MS=5000
MONITOR_DATABASE_PATH=runtime-data/monitor.sqlite

# 遠端部署時才啟用。Cloudflare Access 通過後會加入 JWT assertion header。
MONITOR_REQUIRE_CF_ACCESS=false
MONITOR_ALLOWED_ORIGINS=https://noc-network-incident-copilot.pages.dev,https://xxxx00001235-tech.github.io

# Backend HTTP
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3001
NODE_ENV=development

# PostgreSQL（請將 PGPASSWORD 改為 Ubuntu noc-postgres 的實際密碼）
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=nocdb
PGUSER=nocadmin
PGPASSWORD=change-me
PGSSL=false
PG_CONNECTION_TIMEOUT_MS=3000
