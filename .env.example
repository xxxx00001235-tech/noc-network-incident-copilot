# demo：使用既有展示資料；live：讀取本機監控 API
VITE_DATA_MODE=demo
VITE_API_BASE_URL=http://127.0.0.1:3001

# Ubuntu VM 上的 FastAPI。HTTP API 與 WebSocket 都由這個 URL 衍生，不經過 Vite Proxy。
VITE_FASTAPI_BASE_URL=http://192.168.176.130:8000

# FastAPI 允許的前端來源，以逗號分隔。
FASTAPI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://noc-network-incident-copilot.pages.dev,https://xxxx00001235-tech.github.io
# 預設本機備援；PostgreSQL 可改用 postgresql+psycopg://noc_user:noc_password@localhost:5432/noc_copilot
DATABASE_URL=sqlite:///./fastapi_app/noc.db

# 本機監控 API 固定只監聽 127.0.0.1。
MONITOR_PORT=3001
MONITOR_SAMPLE_INTERVAL_MS=5000
MONITOR_DATABASE_PATH=runtime-data/monitor.sqlite

# 遠端部署時才啟用。Cloudflare Access 通過後會加入 JWT assertion header。
MONITOR_REQUIRE_CF_ACCESS=false
MONITOR_ALLOWED_ORIGINS=https://noc-network-incident-copilot.pages.dev,https://xxxx00001235-tech.github.io

# Backend HTTP
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3001
NODE_ENV=development

# PostgreSQL（請將 PGPASSWORD 改為 Ubuntu noc-postgres 的實際密碼）
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=nocdb
PGUSER=nocadmin
PGPASSWORD=change-me
PGSSL=false
PG_CONNECTION_TIMEOUT_MS=3000
